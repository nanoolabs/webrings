{
  "name": "nanoo-webrings",
  "private": true,
  "type": "module",
  "version": "1.1.4",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "start": "wrangler pages dev dist",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:changed": "git diff --name-only --diff-filter=d HEAD -z | xargs -0 -r prettier --write --ignore-unknown",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-pixel": "^5.3.0",
    "@nlbs/css": "0.3.2",
    "astro": "^7.3.3",
    "sharp": "^0.34.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@parcel/watcher",
      "workerd"
    ]
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "wrangler": "^4.149.0"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write",
    "*.css": "stylelint --fix"
  }
}
