---
interface Props {
  ring?: string
  site?: string
  class?: string
}

const {
  ring = 'nanoo-network',
  site = 'webrings',
  class: className,
} = Astro.props
const baseUrl = 'https://webrings.nanoolabs.dev'

const prevUrl = `${baseUrl}/prev?site=${site}&ring=${ring}`
const nextUrl = `${baseUrl}/next?site=${site}&ring=${ring}`
const hubUrl = baseUrl
---

<div class:list={['nanoo-registry-widget', className]}>
  <div class="reg-box">
    <div class="reg-identity">
      <span class="reg-label-full">REGISTRY_NODE</span>
      <span class="reg-label-short">NODE</span>
    </div>
    <nav class="reg-nav">
      <a href={prevUrl} class="reg-link">
        <span class="reg-glyph">←</span> PREV
      </a>
      <span class="reg-sep">/</span>
      <a href={hubUrl} class="reg-link">HUB</a>
      <span class="reg-sep">/</span>
      <a href={nextUrl} class="reg-link">
        NEXT <span class="reg-glyph">→</span>
      </a>
    </nav>
  </div>
</div>

<style>
  .nanoo-registry-widget {
    --ring-primary: #00ffff;
    --ring-canvas: #050505;
    --ring-canvas-soft: #0a0a0a;
    --ring-hairline: #1f2937;
    --ring-ink: #ffffff;
    --ring-body: #bdbdbd;
    --ring-mute: #6b7280;

    font-family: 'Geist Mono', ui-monospace, monospace;
    text-transform: uppercase;
    font-size: 9px;
    letter-spacing: 0.15em;
    display: inline-block;
    width: auto;
    max-width: 100%;
    -webkit-font-smoothing: antialiased;
  }

  .reg-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border: 1px solid var(--ring-hairline);
    padding: 10px 18px;
    background: var(--ring-canvas-soft);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .reg-box:hover {
    border-color: var(--ring-primary);
    background: var(--ring-canvas);
    box-shadow: 0 0 20px -10px rgba(0, 255, 255, 0.1);
  }

  .reg-identity {
    display: flex;
    align-items: center;
  }

  .reg-label-full {
    display: inline;
  }
  .reg-label-short {
    display: none;
  }

  .reg-label-full,
  .reg-label-short {
    color: var(--ring-mute);
    font-weight: 600;
  }

  .reg-nav {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .reg-link {
    color: var(--ring-ink);
    text-decoration: none;
    transition: all 0.2s ease;
    font-weight: 500;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .reg-link:hover {
    color: var(--ring-primary);
    transform: translateY(-1px);
  }

  .reg-glyph {
    font-size: 11px;
    color: var(--ring-primary);
  }

  .reg-sep {
    color: var(--ring-hairline);
    font-weight: 700;
  }

  @media (max-width: 480px) {
    .reg-box {
      gap: 12px;
      padding: 10px 14px;
    }

    .reg-label-full {
      display: none;
    }
    .reg-label-short {
      display: inline;
    }

    .reg-nav {
      gap: 12px;
    }

    .reg-link {
      font-size: 8px;
    }
  }

  @media (max-width: 320px) {
    .reg-label-short {
      display: none;
    }
    .reg-nav {
      width: 100%;
      justify-content: center;
    }
  }
</style>
